{
  "author": "Xyfir LLC (https://www.xyfir.com)",
  "bugs": {
    "url": "https://github.com/xyfir/wordlist/issues"
  },
  "description": "A cryptographically secure random generator for word lists. Supports custom word lists and optional seeded generation.",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@wordlist/english-eff": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/Random.d.ts",
    "dist/Random.js",
    "dist/RandomWords.d.ts",
    "dist/RandomWords.js"
  ],
  "homepage": "https://github.com/xyfir/wordlist/tree/main/packages/random#readme",
  "keywords": [
    "random",
    "generate",
    "generator",
    "words",
    "word",
    "word list",
    "cryptographically secure",
    "csprng",
    "cprng"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@wordlist/random",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/random",
    "type": "git",
    "url": "git+https://github.com/xyfir/wordlist.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "5.0.0"
}
